apiVersion: metallb.io/v1beta1
kind: IPAddressPool
metadata:
  name: ${CLUSTER}-pool
  namespace: metallb-system
spec:
  addresses:
    - ${POOL_START}-${POOL_END}
---
apiVersion: metallb.io/v1beta1
kind: L2Advertisement
metadata:
  name: ${CLUSTER}-l2
  namespace: metallb-system
spec:
  ipAddressPools:
    - ${CLUSTER}-pool
